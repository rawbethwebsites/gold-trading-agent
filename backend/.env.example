# Gold Trading Agent Configuration

# ============================================
# DATA PROVIDER MODE (Choose one)
# ============================================
# Option 1: demo_trading - Simulated trading with real prices (RECOMMENDED for testing)
#           No MT5 required! Uses public APIs for prices, simulates trades internally.
#           Virtual account with $10,000 demo balance.
#
# Option 2: twelve_data - Real gold prices from Twelve Data API (data only, no trading)
#           Requires TWELVE_DATA_API_KEY below.
#
# Option 3: mt5 - Real trading via MetaTrader 5 terminal (requires Windows + MT5)
#           Most powerful but requires local MT5 installation.
#
# Option 4: mock - Fake simulated data for UI development only
#
# Option 5: multi_asset - Trade both Gold AND Bitcoin! (Gold + BTC/USD)
#           No MT5 required. Best for multi-asset demo trading.
#
DATA_PROVIDER=multi_asset

# Multi-Asset Configuration (for multi_asset mode)
# Comma-separated list of assets to trade: XAUUSD, BTCUSD
ASSETS=XAUUSD,BTCUSD

# ============================================
# TWELVE DATA CONFIGURATION (for twelve_data mode)
# ============================================
# Get free API key at https://twelvedata.com/ (800 calls/day free tier)
# You can add multiple keys separated by commas for automatic rotation
TWELVE_DATA_API_KEYS=your_api_key_here

# Set to false to disable API calls and use cached data (saves API quota)
TWELVE_DATA_API_CALLS_ENABLED=true

# ============================================
# DEMO TRADING CONFIGURATION (for demo_trading mode)
# ============================================
# Starting balance for demo account
INITIAL_BALANCE=10000.0

# ============================================
# MT5 CONFIGURATION (for mt5 mode)
# ============================================
# Exness Demo Account Credentials
ACCOUNT_TYPE=demo
ACCOUNT_NUMBER=12345678
ACCOUNT_PASSWORD=demo
ACCOUNT_SERVER=Exness-MT5

# Optional: MT5 Terminal Path (auto-detected on Windows, set manually on Mac/Linux)
# MT5_TERMINAL_PATH=/Applications/MetaTrader 5.app

# ============================================
# TRADING SETTINGS
# ============================================
# Enable/disable trading globally
ENABLE_TRADING=true

# Demo trades only (safety switch - always true unless you explicitly want live)
ENABLE_DEMO_TRADES=true

# Trading symbol and timeframe
SYMBOL=XAUUSD
TIMEFRAME=H1

# Risk Management
MAX_OPEN_POSITIONS=1
DEFAULT_LOT_SIZE=0.01
MAX_DAILY_LOSS_PERCENT=2.0

# ============================================
# BACKEND CONFIGURATION
# ============================================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
POLLING_INTERVAL=5

# ============================================
# WEBSOCKET CONFIGURATION
# ============================================
WS_HEARTBEAT_INTERVAL=30
