# Gold Trading Agent Configuration

# Twelve Data API Key (get free key at https://twelve-data.com/)
# Without this key, the system will use mock data
TWELVE_DATA_API_KEY=your_api_key_here

# Trading Symbol (XAU/USD for gold)
XAU_SYMBOL=XAU/USD

# Server Configuration
HOST=0.0.0.0
PORT=8000

# WebSocket Configuration
WS_HEARTBEAT_INTERVAL=30
